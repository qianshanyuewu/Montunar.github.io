{
  "name": "montunar-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && node scripts/validate-content.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "playwright test",
    "test:performance": "node scripts/measure-performance.mjs",
    "media": "node scripts/optimize-media.mjs",
    "validate": "node scripts/validate-content.mjs",
    "validate:migration": "node scripts/validate-content.mjs --migration",
    "predev": "node scripts/prepare-assets.mjs",
    "test:authoring": "node scripts/test-authoring.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" \"tests/*.ts\" astro.config.mjs playwright.config.ts README.md"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "entities": "8.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
