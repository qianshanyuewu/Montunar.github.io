---
import '../styles/global.css';
import Toolbar from '../components/Toolbar.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/blog';
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  article?: boolean;
  list?: boolean;
  back?: string;
  backLabel?: string;
  date?: string;
}
const {
  title = '一个小小的思考地方...',
  description = '一个记录个人思考、生活点滴、科技探索和艺术创意的空间。在这里慢慢谈说，分享对世界的观察与感悟。',
  home = false,
  article = false,
  list = false,
  back = 'journal/',
  backLabel = '返回',
  date,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.endsWith('/404/') ? url('404.html') : Astro.url.pathname,
  Astro.site,
);
const siteName = '一个小小的思考地方...';
const ogImage = new URL(url('media/social-card.png'), Astro.site);
const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date,
      inLanguage: 'zh-CN',
      mainEntityOfPage: canonical.href,
      author: { '@type': 'Person', name: 'qianshanyuewu', url: 'https://github.com/qianshanyuewu' },
      image: ogImage.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: new URL(url(''), Astro.site).href,
      inLanguage: 'zh-CN',
    };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{home ? siteName : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={date} />}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        const size = Number(localStorage.getItem('articleFontSize'));
        if (size >= 80 && size <= 150)
          document.documentElement.style.setProperty('--reading-scale', String(size / 100));
        document.documentElement.dataset.animation =
          localStorage.getItem('animationMode') || 'fade';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </head>
  <body class:list={[home && 'is-home', article && 'is-article']}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    {!home && (
      <>
        <canvas id="background-canvas" aria-hidden="true"></canvas>
        <header class="site-header">
          <a class="back-link" href={url(back)}>
            <Icon name="arrow" size={17} />
            {backLabel}
          </a>
          <nav aria-label="主导航">
            <a
              href={url('talking/')}
              aria-current={Astro.url.pathname.includes('/talking/') ? 'page' : undefined}
            >
              慢慢谈说
            </a>
            <a
              href={url('categories/updates/')}
              aria-current={Astro.url.pathname.includes('/updates/') ? 'page' : undefined}
            >
              干了啥
            </a>
            <a
              href={url('about/')}
              aria-current={Astro.url.pathname.includes('/about/') ? 'page' : undefined}
            >
              关于
            </a>
          </nav>
        </header>
      </>
    )}
    <main id="main" class:list={['page-content', home && 'home-content']}>
      <slot />
    </main>
    {!home && (
      <footer class="site-footer">
        <a href={url('')}>一个小小的思考地方...</a>
        <span>慢慢写，慢慢读。</span>
      </footer>
    )}
    <Toolbar article={article} list={list} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
