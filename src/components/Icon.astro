---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  sun: 'M12 3v1m0 16v1M3 12h1m16 0h1M5.6 5.6l.7.7m11.4 11.4.7.7M5.6 18.4l.7-.7M17.7 6.3l.7-.7M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  moon: 'M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z',
  search: 'm20 20-5-5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z',
  music:
    'M9 18V5l11-2v13M9 7l11-2M9 18c0 1.7-1.8 3-4 3s-3-1-3-2.5S4 16 6 16s3 .5 3 2Zm11-2c0 1.7-1.8 3-4 3s-3-1-3-2.5 2-2.5 4-2.5 3 .5 3 2Z',
  settings: 'M4 7h16M4 17h16M8 4v6m8 4v6',
  arrow: 'M19 12H5m6-6-6 6 6 6',
  down: 'm6 9 6 6 6-6',
  up: 'M12 20V4m-7 7 7-7 7 7',
  expand: 'M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5',
  close: 'm6 6 12 12M6 18 18 6',
  book: 'M4 3h14a2 2 0 0 1 2 2v16H6a2 2 0 0 1-2-2V3Zm0 13h16M8 3v13',
  camera: 'M3 7h4l2-3h6l2 3h4v13H3V7Zm13 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.book} />
</svg>
